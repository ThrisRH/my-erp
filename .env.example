MYSQL_DATABASE=erp
MYSQL_USER=erp_app
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
# Port 3306 is occupied by another local project.
MYSQL_PORT=3307
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
# Development only: verification/reset emails go to the container's private outbox.
MAIL_TRANSPORT=outbox
# For private hosting, set MAIL_TRANSPORT=smtp and fill these placeholders locally.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
# Optional: Google Gemini API key for natural language voice parsing
GEMINI_API_KEY=
