                    <input type="hidden" name="csrf_token" value="<?= $this->escapeHtmlAttr(\Application\Helper\Access::csrfToken()) ?>">
                    <button type="submit" class="app-preference-button" data-i18n="auth.signOut">Sign out</button>
                </form>
                <button type="button" class="app-preference-button" data-theme-toggle aria-label="Toggle light and dark mode">
