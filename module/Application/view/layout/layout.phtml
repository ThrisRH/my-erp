<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */

$financeUrl = null;
try {
    $financeUrl = $this->url('personal-finance');
} catch (\Throwable $exception) {
    // The layout remains usable before optional modules are registered.
}

$path = (string) parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH);
$isFinance = $financeUrl !== null && str_starts_with($path, $financeUrl);
$isAuth = in_array($path, ['/login', '/register', '/forgot-password', '/reset-password', '/verify-email'], true);
$isProfile = str_starts_with($path, '/profile');
?>
<?= $this->doctype() ?>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8">
    <?php if ($isAuth): ?><meta name="referrer" content="no-referrer"><?php endif; ?>
    <script>
        document.documentElement.dataset.theme = localStorage.getItem('my-erp-theme') || 'light';
        document.documentElement.lang = localStorage.getItem('my-erp-locale') || 'en';
    </script>
    <?= $this->headTitle('My ERP')->setSeparator(' · ')->setAutoEscape(false) ?>
    <?= $this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1') ?>
    <link rel="icon" type="image/png" href="<?= $this->basePath('img/my-erp-favicon.png') ?>">
    <?= $this->headLink()->appendStylesheet($this->basePath('css/style.css'))
        ->appendStylesheet($this->basePath('css/finance-overrides.css')) ?>
</head>
<body>
    <div class="app-shell<?= $isAuth ? ' auth-shell' : '' ?>">
        <?php if ($isAuth): ?>
        <aside class="auth-intro" aria-label="My ERP">
            <a class="auth-brand" href="<?= $this->url('login') ?>" aria-label="My ERP">
                <img class="app-logo-light" src="<?= $this->basePath('img/my-erp-sidebar-logo-light.png') ?>" alt="My ERP">
                <img class="app-logo-dark" src="<?= $this->basePath('img/my-erp-sidebar-logo.png') ?>" alt="">
