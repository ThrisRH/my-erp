            </div>
            <p class="auth-intro-foot" data-i18n="auth.private">Your information stays in your account.</p>
        </aside>
        <?php else: ?>
        <aside class="app-sidebar">
            <a class="app-brand app-brand-logo" href="<?= $this->url('home') ?>" aria-label="My ERP">
                <img class="app-logo-light" src="<?= $this->basePath('img/my-erp-sidebar-logo-light.png') ?>" alt="My ERP">
                <img class="app-logo-dark" src="<?= $this->basePath('img/my-erp-sidebar-logo.png') ?>" alt="">
            </a>
            <p class="app-nav-caption" data-i18n="app.navigation">APPLICATIONS</p>
            <nav aria-label="Primary navigation">
                <a href="<?= $this->url('home') ?>" <?= $isFinance ? '' : 'aria-current="page"' ?> data-i18n="app.overview">Overview</a>
                <?php if ($financeUrl !== null): ?>
                    <a href="<?= $financeUrl ?>" <?= $isFinance ? 'aria-current="page"' : '' ?> data-i18n="app.personalFinance">Personal finance</a>
                <?php endif; ?>
                <a href="<?= $this->url('profile') ?>" <?= $isProfile ? 'aria-current="page"' : '' ?> data-i18n="auth.profile">Profile &amp; settings</a>
            </nav>
            <div class="app-preferences" aria-label="Interface preferences">
