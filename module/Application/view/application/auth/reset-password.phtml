<section class="auth-card" aria-labelledby="auth-title">
    <div class="auth-card-head">
        <p class="auth-eyebrow" data-i18n="auth.accountRecovery">ACCOUNT RECOVERY</p>
        <h1 id="auth-title" data-i18n="auth.resetTitle">Choose a new password</h1>
        <p data-i18n="auth.resetDescription">Choose at least 12 characters to protect your account.</p>
    </div>
    <?php if ($error !== null): ?><p role="alert" class="auth-error"><?= $this->escapeHtml($error) ?></p><?php endif; ?>
    <?php if ($completed): ?>
        <p class="auth-success" role="status" data-i18n="auth.resetDone">Your password has been updated. Sign in with your new password.</p>
    <?php elseif (!$valid): ?>
        <p role="alert" class="auth-error" data-i18n="auth.expiredLink">This link is invalid or has expired. Request a new one.</p>
        <a href="<?= $this->url('forgot-password') ?>" data-i18n="auth.requestNewLink">Request a new link</a>
    <?php else: ?>
        <form method="post" action="<?= $this->url('reset-password') ?>" class="auth-form">
            <input type="hidden" name="csrf_token" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">
            <input type="hidden" name="token" value="<?= $this->escapeHtmlAttr($token) ?>">
            <label><span data-i18n="auth.newPassword">New password</span><input name="password" type="password" autocomplete="new-password" minlength="12" required><small data-i18n="auth.passwordHint">At least 12 characters.</small></label>
            <label><span data-i18n="auth.confirmPassword">Confirm password</span><input name="password_confirm" type="password" autocomplete="new-password" minlength="12" required></label>
            <button class="pf-button pf-button-primary auth-submit" type="submit" data-i18n="auth.savePassword">Save new password</button>
        </form>
    <?php endif; ?>
    <p class="auth-card-foot"><a href="<?= $this->url('login') ?>" data-i18n="auth.backToSignIn">Back to sign in</a></p>
</section>
