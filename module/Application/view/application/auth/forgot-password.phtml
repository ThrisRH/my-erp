<section class="auth-card" aria-labelledby="auth-title">
    <div class="auth-card-head">
        <p class="auth-eyebrow" data-i18n="auth.accountRecovery">ACCOUNT RECOVERY</p>
        <h1 id="auth-title" data-i18n="auth.forgotTitle">Forgot your password?</h1>
        <p data-i18n="auth.forgotDescription">Enter your account email and we will send a secure reset link.</p>
    </div>
    <?php if ($error !== null): ?><p role="alert" class="auth-error"><?= $this->escapeHtml($error) ?></p><?php endif; ?>
    <?php if ($sent): ?>
        <p class="auth-success" role="status" data-i18n="auth.resetSent">If an account exists for this email, a reset link is on its way. The link expires in 30 minutes.</p>
    <?php else: ?>
        <form method="post" action="<?= $this->url('forgot-password') ?>" class="auth-form">
            <input type="hidden" name="csrf_token" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">
            <label><span data-i18n="auth.workEmail">Email address</span><input name="email" type="email" autocomplete="email" required autofocus></label>
            <button class="pf-button pf-button-primary auth-submit" type="submit" data-i18n="auth.sendReset">Send reset link</button>
        </form>
    <?php endif; ?>
    <p class="auth-card-foot"><a href="<?= $this->url('login') ?>" data-i18n="auth.backToSignIn">Back to sign in</a></p>
</section>
