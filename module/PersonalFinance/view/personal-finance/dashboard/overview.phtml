$formatCompact = static function (float $amount): string {
    $abs = abs($amount);
    if ($abs >= 1_000_000_000) {
        $val = round($abs / 1_000_000_000, 1);
        $formatted = (rtrim(rtrim(number_format($val, 1, '.', ''), '0'), '.') ?: '0') . 'B';
    } elseif ($abs >= 1_000_000) {
        $val = round($abs / 1_000_000, 1);
        $formatted = (rtrim(rtrim(number_format($val, 1, '.', ''), '0'), '.') ?: '0') . 'M';
    } elseif ($abs >= 1_000) {
        $val = round($abs / 1_000, 1);
        $formatted = (rtrim(rtrim(number_format($val, 1, '.', ''), '0'), '.') ?: '0') . 'K';
    } else {
        $formatted = (string) round($abs);
    }
    return ($amount < 0 ? '-' : '') . $formatted;
};

