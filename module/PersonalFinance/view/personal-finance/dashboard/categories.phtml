<?php use PersonalFinance\Service\CategoryIcons; ?>
<section class="pf-panel"><div class="pf-section-head"><div><p class="pf-eyebrow" data-i18n="finance.classification">PHÂN LOẠI</p><h2 data-i18n="finance.categoryListTitle">Danh mục thu chi</h2><p class="pf-subtitle">Sắp xếp giao dịch theo nhóm phù hợp với bạn.</p></div><button class="pf-button pf-button-primary" data-modal-open="category-modal" data-i18n="finance.createCategory">+ Tạo danh mục</button></div>
<div class="pf-category-columns"><?php foreach (['incomeCategories' => 'Khoản thu', 'expenseCategories' => 'Khoản chi'] as $key => $title): ?><div><h3><?= $title ?></h3><?php $categoryNames = []; foreach ($dashboard[$key] as $category) { $categoryNames[(int) $category['id']] = $category['name']; } foreach ($dashboard[$key] as $category): ?><div class="pf-category-row"><span class="pf-category-icon"><?= CategoryIcons::svg($category['icon']) ?></span><span><?= $this->escapeHtml($category['name']) ?><?php if ((int) $category['parent_id'] > 0): ?><small>Trong <?= $this->escapeHtml($categoryNames[(int) $category['parent_id']] ?? 'danh mục khác') ?></small><?php endif; ?></span></div><?php endforeach; ?></div><?php endforeach; ?></div></section>
<dialog id="category-modal" class="pf-modal" aria-labelledby="category-modal-title"><form method="post" action="<?= $this->url('personal-finance/action', ['action' => 'add-category']) ?>"><div class="pf-modal-head"><h2 id="category-modal-title">Tạo danh mục</h2><button type="button" class="pf-icon-button" data-modal-close aria-label="Đóng">×</button></div><input type="hidden" name="month" value="<?= $month->format('Y-m') ?>"><div class="pf-form-grid"><label>Tên danh mục<input name="name" maxlength="100" required></label><label>Loại<select name="transaction_type" id="category-type"><option value="expense">Chi</option><option value="income">Thu</option></select></label><label>Danh mục cha<select name="parent_id" id="category-parent"><option value="0">Danh mục gốc</option><?php foreach (array_merge($dashboard['incomeCategories'], $dashboard['expenseCategories']) as $category): ?><option value="<?= (int) $category['id'] ?>" data-type="<?= $this->escapeHtmlAttr($category['transaction_type']) ?>"><?= $this->escapeHtml($category['name']) ?></option><?php endforeach; ?></select></label><fieldset class="pf-full pf-icon-picker"><legend>Biểu tượng</legend><?php foreach (CategoryIcons::names() as $icon): ?><label title="<?= $this->escapeHtmlAttr($icon) ?>"><input type="radio" name="icon" value="<?= $this->escapeHtmlAttr($icon) ?>" <?= $icon === 'folder' ? 'checked' : '' ?>><span><?= CategoryIcons::svg($icon) ?></span></label><?php endforeach; ?></fieldset></div><div class="pf-modal-actions"><button type="button" class="pf-button pf-button-secondary" data-modal-close>Hủy</button><button class="pf-button pf-button-primary">Tạo danh mục</button></div></form></dialog>
