            <fieldset class="pf-full pf-icon-picker"><legend data-i18n="finance.icon">Icon</legend><?php foreach (CategoryIcons::names() as $icon): ?><label title="<?= $this->escapeHtmlAttr($icon) ?>"><input type="radio" name="icon" value="<?= $this->escapeHtmlAttr($icon) ?>" <?= $icon === 'folder' ? 'checked' : '' ?>><span><?= CategoryIcons::svg($icon) ?></span></label><?php endforeach; ?></fieldset>
