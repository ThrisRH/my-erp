<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */
use PersonalFinance\View\Helper\CategoryIcons;
use PersonalFinance\View\Helper\UiIcons;

$allCategories = array_merge($dashboard['incomeCategories'], $dashboard['expenseCategories']);
$categoryNames = [];
foreach ($allCategories as $category) {
    $categoryNames[(int) $category['id']] = $category['name'];
}
?>
<section class="pf-panel">
    <div class="pf-section-head">
        <div>
            <p class="pf-eyebrow" data-i18n="finance.classification">CLASSIFICATION</p>
            <h2 data-i18n="finance.categoryListTitle">Income and expense categories</h2>
            <p class="pf-subtitle" data-i18n="finance.categoryDescription">Organize transactions into groups that work for you.</p>
        </div>
        <button class="pf-button pf-button-primary" data-modal-open="category-modal" data-i18n="finance.createCategory">+ Create category</button>
    </div>
    <div class="pf-category-columns">
        <?php foreach (['incomeCategories' => ['Income categories', 'finance.incomeCategories'], 'expenseCategories' => ['Expense categories', 'finance.expenseCategories']] as $key => $title): ?>
            <div>
                <h3 data-i18n="<?= $title[1] ?>"><?= $title[0] ?></h3>
                <?php foreach ($dashboard[$key] as $category): ?>
                    <div class="pf-category-row">
                        <span class="pf-category-icon"><?= CategoryIcons::svg($category['icon']) ?></span>
                        <span class="pf-category-copy">
                            <?= $this->escapeHtml($category['name']) ?>
                            <?php if ((int) $category['parent_id'] > 0): ?>
                                <small><span data-i18n="finance.inCategory">In</span> <?= $this->escapeHtml($categoryNames[(int) $category['parent_id']] ?? 'another category') ?></small>
                            <?php endif; ?>
                        </span>
                        <?php if ($category['employee_id'] !== null && !(bool) $category['is_system']): ?>
                            <span class="pf-category-actions">
                                <button type="button" class="pf-icon-button" data-category-edit
                                    data-id="<?= (int) $category['id'] ?>"
                                    data-name="<?= $this->escapeHtmlAttr($category['name']) ?>"
                                    data-icon="<?= $this->escapeHtmlAttr($category['icon']) ?>"
                                    data-parent-id="<?= (int) $category['parent_id'] ?>"
                                    data-type="<?= $this->escapeHtmlAttr($category['transaction_type']) ?>"
                                    aria-label="Edit category" data-i18n-aria-label="finance.editCategory"><?= UiIcons::svg('edit') ?></button>
                                <button type="button" class="pf-icon-button pf-icon-button-danger" data-category-delete
                                    data-id="<?= (int) $category['id'] ?>"
                                    data-name="<?= $this->escapeHtmlAttr($category['name']) ?>"
                                    aria-label="Delete category" data-i18n-aria-label="finance.deleteCategory"><?= UiIcons::svg('trash') ?></button>
                            </span>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endforeach; ?>
    </div>
</section>

